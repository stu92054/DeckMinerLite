<Window x:Class="DeckMiner.Gui.FanLevelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="編輯粉絲等級" Height="600" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 說明 -->
        <GroupBox Header="說明" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                    設定每個角色的粉絲等級（0-10）
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray">
                    粉絲等級會影響卡組的得分加成，預設為 10
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <!-- 角色粉絲等級列表 -->
        <GroupBox Header="角色粉絲等級" Grid.Row="1" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FanLevelsPanel" Margin="10"/>
            </ScrollViewer>
        </GroupBox>

        <!-- 按鈕 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="全部設為 10" Click="SetAllTo10Button_Click" Width="100" Margin="0,0,5,0"/>
            <Button Content="確定" Click="OkButton_Click" Width="80" IsDefault="True" Margin="0,0,5,0"/>
            <Button Content="取消" Click="CancelButton_Click" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
