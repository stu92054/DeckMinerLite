<Window x:Class="DeckMiner.Gui.OptimizerConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="優化器配置" Height="450" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 說明 -->
        <GroupBox Header="說明" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                    優化器配置用於 multi_optimizer_2.py 多曲優化程式
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray">
                    用於優化多首歌曲的卡組組合，尋找最佳的整體得分
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <!-- 配置選項 -->
        <GroupBox Header="優化器設定" Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <!-- Top N -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="保留前 N 名卡組:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="TopNTextBox" Width="120" VerticalAlignment="Center"/>
                        <TextBlock Text="(預設: 50000)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <!-- Show Card Names -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="顯示卡牌名稱:" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ShowCardNamesCheckBox" Grid.Column="1" Content="在輸出中顯示卡牌名稱" VerticalAlignment="Center"/>
                </Grid>

                <!-- Forbidden Cards -->
                <TextBlock Text="全局禁卡 (三面均生效):" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBlock Text="這些卡片在所有三首歌曲中都不會被使用" FontSize="11" Foreground="Gray" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ForbiddenCardsComboBox" Grid.Column="0"/>
                    <Button Content="新增" Grid.Column="1" Click="AddForbiddenCard_Click" Width="60" Margin="5,0"/>
                    <Button Content="清空" Grid.Column="2" Click="ClearForbiddenCards_Click" Width="60"/>
                </Grid>
                <ListBox x:Name="ForbiddenCardsListBox" Height="120" SelectionMode="Single"
                         MouseDoubleClick="ForbiddenCardsListBox_MouseDoubleClick"
                         ToolTip="雙擊移除卡片"/>
            </StackPanel>
        </GroupBox>

        <!-- 底部按鈕 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="確定" Click="OkButton_Click" Width="80" IsDefault="True" Margin="0,0,5,0"/>
            <Button Content="取消" Click="CancelButton_Click" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
