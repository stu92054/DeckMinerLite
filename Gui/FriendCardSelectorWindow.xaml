<Window x:Class="DeckMiner.Gui.FriendCardSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="選擇朋友卡片" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜尋區域 -->
        <GroupBox Header="搜尋" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="關鍵字:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="SearchTextBox" Grid.Column="1"
                             TextChanged="SearchTextBox_TextChanged"
                             ToolTip="可搜尋卡片 ID、角色名稱、卡片名稱"/>
                    <Button x:Name="ClearSearchButton" Grid.Column="2" Content="清空"
                            Click="ClearSearchButton_Click" Width="60" Margin="5,0,0,0"/>
                </Grid>
                <TextBlock Text="提示：輸入卡片 ID、角色名稱或卡片名稱進行搜尋"
                           FontSize="11" Foreground="Gray" Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 統計資訊 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="ResultCountText" Text="顯示 0 張卡片" VerticalAlignment="Center"/>
            <TextBlock x:Name="SelectedCountText" Text=" | 已選擇 0 張" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Blue"/>
        </StackPanel>

        <!-- 卡片列表 -->
        <GroupBox Header="卡片列表（雙擊選擇）" Grid.Row="2">
            <DataGrid x:Name="CardsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      MouseDoubleClick="CardsDataGrid_MouseDoubleClick"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F5F5F5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding CardId}" Width="80"/>
                    <DataGridTextColumn Header="稀有度" Binding="{Binding RarityString}" Width="60"/>
                    <DataGridTextColumn Header="角色" Binding="{Binding CharacterName}" Width="120"/>
                    <DataGridTextColumn Header="卡片名稱" Binding="{Binding CardName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 已選擇的卡片 -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="已選擇的卡片 (雙擊上方列表可新增/移除):" FontWeight="Bold"/>
                <Button Grid.Column="1" Content="全部清空" Click="ClearAllButton_Click" Width="80"/>
            </Grid>
            <ListBox x:Name="SelectedCardsListBox"
                     Height="80"
                     SelectionMode="Single"
                     MouseDoubleClick="SelectedCardsListBox_MouseDoubleClick"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="確定" Click="OkButton_Click" Width="80" IsDefault="True" Margin="0,0,5,0"/>
                <Button Content="取消" Click="CancelButton_Click" Width="80" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
