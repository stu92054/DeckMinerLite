<Window x:Class="DeckMiner.Gui.CardPoolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Card Pool Editor" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filters -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="SearchTextBox" Width="200" TextChanged="SearchTextBox_TextChanged"/>
            
            <TextBlock Text="Character:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <ComboBox x:Name="CharacterFilterComboBox" Width="120" SelectionChanged="Filter_SelectionChanged"/>
            
            <TextBlock Text="Rarity:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <ComboBox x:Name="RarityFilterComboBox" Width="80" SelectionChanged="Filter_SelectionChanged"/>
        </StackPanel>

        <!-- Lists -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Available Cards -->
            <GroupBox Header="Available Cards" Grid.Column="0">
                <ListBox x:Name="AvailableCardsListBox" SelectionMode="Extended" DisplayMemberPath="DisplayName">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </GroupBox>

            <!-- Buttons -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10">
                <Button Content="Add &gt;" Click="AddButton_Click" Width="50" Margin="0,0,0,10"/>
                <Button Content="&lt; Remove" Click="RemoveButton_Click" Width="50"/>
                <Button Content="Add All &gt;&gt;" Click="AddAllButton_Click" Width="80" Margin="0,20,0,10"/>
                <Button Content="&lt;&lt; Remove All" Click="RemoveAllButton_Click" Width="80"/>
            </StackPanel>

            <!-- Selected Cards -->
            <GroupBox Header="Selected Cards (Edit Levels)" Grid.Column="2">
                <ListBox x:Name="SelectedCardsListBox" SelectionMode="Extended" HorizontalContentAlignment="Stretch">
                     <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0">
                                    <TextBlock Text="Lv:" VerticalAlignment="Center" FontSize="10" Foreground="Gray"/>
                                    <TextBox Text="{Binding Level}" Width="40" Margin="2,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5,0">
                                    <TextBlock Text="CS:" VerticalAlignment="Center" FontSize="10" Foreground="Gray"/>
                                    <TextBox Text="{Binding CenterSkillLevel}" Width="30" Margin="2,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="5,0">
                                    <TextBlock Text="S:" VerticalAlignment="Center" FontSize="10" Foreground="Gray"/>
                                    <TextBox Text="{Binding SkillLevel}" Width="30" Margin="2,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="CountText" Text="Selected: 0" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="OK" Click="OkButton_Click" Width="80" IsDefault="True"/>
            <Button Content="Cancel" Click="CancelButton_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
